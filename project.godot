; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gato Gloton"
config/description="Arcade de laberinto con gatos: come bolas de pelo y escapa de los rivales."
run/main_scene="res://src/game/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.027451, 0.031373, 0.090196, 1)
boot_splash/show_image=false
config/icon="res://assets/icon_pixel.png"

[autoload]

GameState="*res://src/autoload/game_state.gd"
SaveManager="*res://src/autoload/save_manager.gd"
ProgressionManager="*res://src/autoload/progression_manager.gd"
AchievementManager="*res://src/autoload/achievement_manager.gd"
UnlockManager="*res://src/autoload/unlock_manager.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
AdsManager="*res://src/autoload/ads_manager.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[dotnet]

project/assembly_name="Gato Gloton"

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.027451, 0.031373, 0.090196, 1)
